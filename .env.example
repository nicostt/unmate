# Copiá este archivo con el nombre .env.local y completá los dos valores.
# Los encontrás en Supabase: botón "Connect" arriba, o Settings > API Keys.
# Estas dos claves son públicas por diseño (viajan al navegador).
# La clave SECRETA (sb_secret_...) NO va acá ni en ningún archivo del proyecto.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
